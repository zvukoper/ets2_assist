  "dialogues": {
    "ruslan_start": { "speaker": "Руслан", "text": "Приветствую, бродяга. Что интересует?", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [
      { "text": "Хочу попробовать твой лучший шашлык!", "serviceText": "[+1 выносливость, +1 сила]", "next": "ruslan_special_offer" },
      { "text": "Ищу подработку. Нужно с чем подсобить?", "serviceText": "[+ репутация]", "next": "ruslan_job_offer" },
      { "text": "Пока ничего, просто осматриваюсь.", "close": true }
    ]},
    "ruslan_special_offer": { "speaker": "Руслан", "text": "Тогда ты по адресу. У меня есть специальная версия шашлыка, проверенный веками рецепт, доведённый до совершенства. Я его не продаю массово, только для специальных клиентов. И дело не в деньгах, хотя он стоит прилично. Я должен убедиться, что ты надёжный клиент. Выполни для меня задание и посмотрим.", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [
      { "text": "Хорошо. Что нужно сделать?", "close": true, "effects": [ { "setQuestStatus": "Active", "setStep": "meat_pickup" } ] },
      { "text": "Понял, подумаю ещё.", "close": true }
    ]},
    "ruslan_job_offer": { "speaker": "Руслан", "text": "Есть одно дело. Нужно сгонять к знакомому мяснику за лучшим свежим мясом в секретном маринаде. Я пока не могу, заказов много. Если поможешь, угощу тебя кое-чем необычным. У меня есть специальная версия шашлыка, проверенный веками рецепт, доведённый до совершенства. Я его не продаю массово, только для специальных клиентов. Не пожалеешь. Если согласен, дам адрес. Его сейчас предупрежу, что ты заедешь.", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [
      { "text": "Согласен. Где забирать?", "close": true, "effects": [ { "setQuestStatus": "Active", "setStep": "meat_pickup" } ] },
      { "text": "Понял, подумаю ещё.", "close": true }
    ]},
    "ruslan_waiting": { "speaker": "Руслан", "text": "Привёз мясо?", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [
      { "text": "Да, держи.", "serviceText": "[требуется: Мясо в спецмаринаде x1]", "requirements": { "all": [ { "item": "special_marinade_meat", "amount": 1 } ], "any": [], "none": [] }, "next": "ruslan_completed", "effects": [ { "item": "special_marinade_meat", "removeItem": 1 }, { "setQuestStatus": "Completed", "setStep": "completed" } ] },
      { "text": "В процессе.", "close": true },
      { "text": "Слушай, пока никак не получается. Давай как-нибудь потом.", "close": true, "effects": [ { "setQuestStatus": "Available", "setStep": "available", "flag": "returnOffer", "setFlag": true } ] }
    ]},
    "ruslan_return_offer": { "speaker": "Руслан", "text": "С возвращением. Не передумал? Предложение всё еще в силе.", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [
      { "text": "Согласен. Где забирать?", "close": true, "effects": [ { "setQuestStatus": "Active", "setStep": "meat_pickup", "flag": "returnOffer", "setFlag": false } ] },
      { "text": "Понял, подумаю ещё.", "close": true }
    ]},
    "ruslan_completed": { "speaker": "Руслан", "text": "Спасибо тебе огромное. Вот, попробуй шашлык мой. Говорят от него прям духом воспрянешь. Если понравится, забегай ещё. У меня всегда есть чего перекусить вкусного и тебе будет скидка.", "image": "quests/images/ruslan_shahlichnik.jpg", "options": [ { "text": "Спасибо. Пока.", "close": true } ] },
    "gosha_meat": { "speaker": "Мясник Гоша", "text": "Ты от Руслана? Держи, свежайшая отборная шея в спецмаринаде. Привет Руслану.", "image": "images/quest/gosha.svg", "options": [
      { "text": "Спасибо. Пока.", "close": true, "effects": [ { "item": "special_marinade_meat", "addItem": 1 }, { "setStep": "return_to_ruslan" }, { "renameInteraction": "gosha", "renameTo": "Мясник Гоша", "notifyText": "Получено: Мясо в спецмаринаде x1" } ] },
      { "text": "Я загляну позже", "close": true }
    ]}
  },
