<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ETS2_Assist</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <VersionMajor>1</VersionMajor>
    <VersionStage>0</VersionStage>
    <VersionSet>39</VersionSet>
    <VersionIter>67</VersionIter>
    <VersionDesc>MAP2-TERRAIN-CITIES2</VersionDesc>
    <BuildDate>$([System.DateTime]::Now.ToString('MM.dd'))</BuildDate>
    <BuildTime>$([System.DateTime]::Now.ToString('Hmm'))</BuildTime>
    <DescriptiveVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)-$(VersionDesc)-$(BuildDate)-$(BuildTime)</DescriptiveVersion>
    <Version>$(VersionMajor).$(VersionStage).$(VersionSet)</Version>
    <AssemblyVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)</FileVersion>
    <AssemblyInformationalVersion>$(DescriptiveVersion)</AssemblyInformationalVersion>
    <InformationalVersion>$(DescriptiveVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>data\ets2_assist.ico</ApplicationIcon>
</PropertyGroup>
  <ItemGroup>
    <None Remove="data\**\*" />
    <Content Include="data\**\*" Exclude="data\bin\WebOverlay.exe.WebView2\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="language\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="SyncDataToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_SourceTopDirs Include="data\*\" Exclude="data\bin\">
        <_PublishPath>$(PublishDir)%(Identity)</_PublishPath>
      </_SourceTopDirs>
      <_DataSourceFiles Include="data\**\*" Exclude="data\bin\WebOverlay.exe.WebView2\**" />
    </ItemGroup>
    <RemoveDir Directories="@(_SourceTopDirs->'$(PublishDir)%(Identity)')" />
    <Copy SourceFiles="@(_DataSourceFiles)" DestinationFiles="@(_DataSourceFiles->'$(PublishDir)data\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Message Text="SyncDataToPublish: скопировано @(_DataSourceFiles->Count()) файлов data -> $(PublishDir)data" Importance="high" />
  </Target>
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
  </ItemGroup>
</Project>
