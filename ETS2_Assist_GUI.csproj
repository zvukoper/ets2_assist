<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>

    <!-- Имя выходного EXE (файл). Namespace проекта остаётся ETS2_Assist_GUI. -->
    <AssemblyName>ETS2_Assist</AssemblyName>

    <!-- Настройки публикации в один EXE -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Обрезку НЕ включаем! -->
    <!-- <PublishTrimmed>false</PublishTrimmed> (по умолчанию false) -->
    <!-- Можно ускорить запуск (опционально) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!--
      ВЕРСИОНИРОВАНИЕ (НОВОЕ ПРАВИЛО с 28.08.2026, уточнено позже):
      Формат человекочитаемой версии: A.B.C.D-DESC-MM.DD-Hmm
        A — поколение проекта (1). Меняется редко.
        B — ключевой этап (0). Повышается ПО КОМАНДЕ при внедрении существенного функционала.
        C — номер текущего НАБОРА целей/проблем (38). НЕ меняется, пока не пофиксим и не
            начнём использовать новый формат; потом сбрасывается и растёт по команде.
        D — ИТЕРАЦИЯ (счётчик работ по задачам из C). БАМПИТСЯ АВТОМАТИЧЕСКИ агентом:
            +1 при завершении работы по задаче И +1 при каждом тест-билде. A,B,C — только по команде.
        DESC — краткое описание проблем, решаемых в текущей D (обновляется агентом вместе с D).
        MM.DD — дата сборки (месяц.число, ведущие нули). Год не указываем (не нужен).
        Hmm — время сборки: час БЕЗ ведущего нуля, минуты С ведущим нулём, без разделителей.
              Пример: 9:22 -> 922, 13:47 -> 1347. UNIX-секунды убрали (слишком длинные).
      - <Version> = A.B.C (ЧИСТЫЙ SemVer!) — для restore. 4-я цифра (D) НЕ в <Version>,
        иначе restore падает молча (ловушка SemVer). D уходит только в FileVersion/AssemblyVersion
        и в строку InformationalVersion.
      - BuildInfo.Version берёт AssemblyInformationalVersion => синхронизировано автоматично.
    -->
    <VersionMajor>1</VersionMajor>
    <VersionStage>0</VersionStage>
    <VersionSet>38</VersionSet>
        <VersionIter>48</VersionIter>
        <VersionDesc>UI-FIXES</VersionDesc>
    <BuildDate>$([System.DateTime]::Now.ToString('MM.dd'))</BuildDate>
    <BuildTime>$([System.DateTime]::Now.ToString('Hmm'))</BuildTime>
    <DescriptiveVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)-$(VersionDesc)-$(BuildDate)-$(BuildTime)</DescriptiveVersion>
    <Version>$(VersionMajor).$(VersionStage).$(VersionSet)</Version>
    <AssemblyVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionStage).$(VersionSet).$(VersionIter)</FileVersion>
    <AssemblyInformationalVersion>$(DescriptiveVersion)</AssemblyInformationalVersion>
    <InformationalVersion>$(DescriptiveVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>data\ets2_assist.ico</ApplicationIcon>
</PropertyGroup>
  <ItemGroup>
    <None Remove="data\**\*" />
    <Content Include="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Локализация (резервный путь BaseDirectory/language; основной — data/language) -->
    <Content Include="language\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Синхронизация исходной папки data поверх папки публикации ПОСЛЕ билда.
    Копируем исходную data ПОВЕРХ publish\data (как просил пользователь), перезаписывая
    файлы. Чтобы не оставлять устаревшие файлы внутри исходных папок, для каждой
    ТОП-УРОВНЕВОЙ папки, которая ЕСТЬ в исходниках (js, css, GeoJson, language, bin, ...),
    сначала удаляем её копию в publish и копируем заново. ВАЖНО: целиком publish\data мы НЕ
    удаляем — поэтому runtime-артефакты, которых нет в исходниках (напр. web_data.json,
    сгенерированный приложением), и прочие внешние файлы сохраняются. Папка data\bin
    (ets2c.exe, WebOverlay.exe) теперь есть в исходниках, поэтому тоже копируется и при
    чистом билде не теряется.
  -->
  <Target Name="SyncDataToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_SourceTopDirs Include="data\*\">
        <_PublishPath>$(PublishDir)%(Identity)</_PublishPath>
      </_SourceTopDirs>
      <_DataSourceFiles Include="data\**\*" />
    </ItemGroup>
    <RemoveDir Directories="@(_SourceTopDirs->'$(PublishDir)%(Identity)')" />
    <Copy SourceFiles="@(_DataSourceFiles)"
          DestinationFiles="@(_DataSourceFiles->'$(PublishDir)data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Message Text="SyncDataToPublish: скопировано @(_DataSourceFiles->Count()) файлов data -> $(PublishDir)data" Importance="high" />
  </Target>

  <ItemGroup>
  <None Include=".github\copilot-instructions.md" />
</ItemGroup>

  <!-- Удалён PackageReference на System.Configuration.ConfigurationManager -->

  <!-- SDK_Test содержит отдельный диагностический WinForms-тест и не должен компилироваться в основной EXE. -->

  <ItemGroup>
    <!-- Runtime data is authoritative under bin\Release\net10.0-windows\win-x64\publish\data.
         Do not overwrite it from the legacy root data folder during publish. -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
  </ItemGroup>
</Project>